local B64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_MAP = {}
for index = 1, #B64_ALPHABET do
	B64_MAP[string.byte(B64_ALPHABET, index)] = index - 1
end

local function decodeBase64(data)
	local out = {}
	local count = 0
	for i = 1, #data, 4 do
		local a, b, c, d = string.byte(data, i, i + 3)
		local n1, n2 = B64_MAP[a], B64_MAP[b]
		local n3 = c and B64_MAP[c] or nil
		local n4 = d and B64_MAP[d] or nil
		if n1 and n2 then
			local value = n1 * 262144 + n2 * 4096 + (n3 or 0) * 64 + (n4 or 0)
			local b1 = math.floor(value / 65536)
			local b2 = math.floor(value / 256) % 256
			local b3 = value % 256
			count = count + 1
			if n3 and n4 then
				out[count] = string.char(b1, b2, b3)
			elseif n3 then
				out[count] = string.char(b1, b2)
			else
				out[count] = string.char(b1)
			end
		end
	end
	return table.concat(out)
end

