--== Unload ==
local function unload()
	hub.running = false
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)
	clearEsp()
	pcall(function()
		applyFullbright(false)
	end)
	pcall(function()
		local humanoid = getHumanoid()
		if humanoid and mods.speedWasOn then
			humanoid.WalkSpeed = mods.defaultSpeed
		end
		if humanoid and mods.jumpWasOn then
			humanoid.JumpPower = mods.defaultJump
		end
		local camera = getCamera()
		if camera and mods.fovWasOn then
			camera.FieldOfView = mods.defaultFov
		end
	end)
	if tracer then
		pcall(function()
			tracer:Remove()
		end)
	end
	for _, gui in ipairs({ radarGui, passGui, dangerGui, fire.gui, wall.gui }) do
		pcall(function()
			gui:Destroy()
		end)
	end
	pcall(function()
		Window:Destroy()
	end)
	environment.KZ_Unload = nil
	environment.KZ = nil
	print("[KZ] unloaded")
end
environment.KZ_Unload = unload

