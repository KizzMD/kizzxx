local function CreateButton(name, code)
    local btn = Instance.new("TextButton")
    btn.Parent = ScrollingFrame
    btn.Size = UDim2.new(1, -5, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(27, 32, 51)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamMedium
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(226, 230, 250)
    btn.TextSize = 13
    btn.AutoButtonColor = true

    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 7)

    local s = Instance.new("UIStroke", btn)
    s.Thickness = 1
    s.Color = Color3.fromRGB(54, 61, 91)

    btn.MouseButton1Click:Connect(function()
        local success, err = pcall(code)
        if not success then
            warn("KizzxxDev error: " .. tostring(err))
        end
    end)
end

