				speed = 2.2 + math.random() * 2.4,
			})
		end
	end

	for _, side in ipairs({ "L", "R" }) do
		for _ = 1, EMBERS_PER_SIDE do
			local ember = Instance.new("Frame")
			ember.BackgroundColor3 = FIRE_PRESETS.Purple[2]
			ember.BorderSizePixel = 0
			ember.ZIndex = 4
			ember.Parent = holder

