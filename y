local function loadArt(fileName, artParts)
	if typeof(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then
		return nil
	end
	local ok, asset = pcall(function()
		if typeof(makefolder) == "function" and typeof(isfolder) == "function" and not isfolder("KizzDev") then
			makefolder("KizzDev")
		end
		local filePath = "KizzDev/" .. fileName
		writefile(filePath, decodeBase64(table.concat(artParts)))
		return getcustomasset(filePath)
	end)
	if ok and type(asset) == "string" and asset ~= "" then
		return asset
	end
	return nil
end

