		local handles = {
			AutoLoot = AutoLoot,
			AutoHide = AutoHide,
			LootTargets = LootTargets,
			LootMode = LootMode,
			HideMode = HideMode,
			EspDrawer = EspDrawer,
			EspWardrobe = EspWardrobe,
			FireEnabled = FireEnabled,
			FireColor = FireColor,
		}
		local handle = handles[name]
		if handle and handle.Set then
			handle:Set(value)
			return true
		end
		return false
	end,
}

--== Background loops ==
local function loop(label, interval, callback)
	task.spawn(function()
		while hub.running do
			local ok, err = pcall(callback)
			if not ok then
				warn("[KZ] " .. label .. ": " .. tostring(err))
			end
			task.wait(interval)
		end
	end)
end

